<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ecommerce.mapper.CartItemMapper">

    <!-- 按用户ID查询购物车列表 -->
    <select id="findByUserId" resultType="com.ecommerce.model.entity.CartItem">
        SELECT id, user_id, product_id, quantity, created_at
        FROM cart_item
        WHERE user_id = #{userId}
    </select>

    <!-- 按用户ID和商品ID查询购物车项 -->
    <select id="findByUserIdAndProductId" resultType="com.ecommerce.model.entity.CartItem">
        SELECT id, user_id, product_id, quantity, created_at
        FROM cart_item
        WHERE user_id = #{userId} AND product_id = #{productId}
    </select>

    <!-- 插入购物车项，返回自增ID -->
    <insert id="insert" parameterType="com.ecommerce.model.entity.CartItem"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cart_item (user_id, product_id, quantity, created_at)
        VALUES (#{userId}, #{productId}, #{quantity}, #{createdAt})
    </insert>

    <!-- 更新购物车项数量 -->
    <update id="updateQuantity">
        UPDATE cart_item
        SET quantity = #{quantity}
        WHERE id = #{id}
    </update>

    <!-- 按ID删除购物车项 -->
    <delete id="deleteById">
        DELETE FROM cart_item WHERE id = #{id}
    </delete>

    <!-- 按用户ID清空购物车 -->
    <delete id="deleteByUserId">
        DELETE FROM cart_item WHERE user_id = #{userId}
    </delete>

    <!-- 按商品ID删除所有用户购物车中的该商品 -->
    <delete id="deleteByProductId">
        DELETE FROM cart_item WHERE product_id = #{productId}
    </delete>

</mapper>
